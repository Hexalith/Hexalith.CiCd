+          dotnet-version: '11.0.x'
+      - name: Requalify immediately before OIDC exchange
+        env:
+          GH_TOKEN: ${{ github.token }}
+          PREREQUISITE_OWNER_SOURCE: 264e5de34341187a0ad4724dd6a39248b9cb9b58
+          HEXALITH_RELEASE_PUBLISH_ENABLED: ${{ vars.HEXALITH_RELEASE_PUBLISH_ENABLED }}
+        run: python3 -I .prerequisite-owner/tools/publish_contracts_prerequisite.py qualify --profile projects --report prerequisite-pre-oidc.json
