+Require-Match $release '(?m)^on:\r?\n  workflow_dispatch:\r?$' 'Release must be dispatch-only.'
+Forbid-Match $release 'allow_stale_g6|ALLOW_STALE_G6' 'Release must not include a stale G-6 bypass.'
