diff --git a/.github/actions/after-integration-tests/action.yml b/.github/actions/after-integration-tests/action.yml
new file mode 100644
index 00000000..79fdf25e
--- /dev/null
+++ b/.github/actions/after-integration-tests/action.yml
@@ -0,0 +1,13 @@
+name: Folders browser checks
+description: Run the complete UI E2E project including accessibility using the shared build and browser installation.
+runs:
+  using: composite
+  steps:
+    - name: Run complete AppHost project including explicit and cross-process controls
+      shell: pwsh
+      env:
+        HEXALITH_FOLDERS_RUN_ASPIRE_INTEGRATION: 'true'
+      run: ./tests/tools/run-complete-project-tests.ps1 -ProjectName Hexalith.Folders.AppHost.Tests
+    - name: Run complete UI E2E project
+      shell: pwsh
+      run: ./tests/tools/run-complete-project-tests.ps1 -ProjectName Hexalith.Folders.UI.E2E.Tests
diff --git a/.github/actions/after-unit-tests/action.yml b/.github/actions/after-unit-tests/action.yml
new file mode 100644
index 00000000..61c580ba
--- /dev/null
+++ b/.github/actions/after-unit-tests/action.yml
@@ -0,0 +1,32 @@
+name: Folders contract and generated artifact checks
+description: Run complete delegated projects and distinct package and capacity product checks using shared Release outputs.
+runs:
+  using: composite
+  steps:
+    - name: Verify product source whitespace
+      shell: bash
+      run: dotnet format whitespace Hexalith.Folders.CI.slnx --verify-no-changes --no-restore --include ./src/ ./tests/ ./samples/
+    - name: Verify product source analyzers
+      shell: bash
+      run: dotnet format analyzers Hexalith.Folders.CI.slnx --verify-no-changes --no-restore --severity warn --include ./src/ ./tests/ ./samples/ --exclude-diagnostics CA1822 CA2007
+    - name: Run complete Contracts project
+      shell: pwsh
+      run: ./tests/tools/run-complete-project-tests.ps1 -ProjectName Hexalith.Folders.Contracts.Tests
+    - name: Run complete Client project
+      shell: pwsh
+      run: ./tests/tools/run-complete-project-tests.ps1 -ProjectName Hexalith.Folders.Client.Tests
+    - name: Run complete core provider project
+      shell: pwsh
+      run: ./tests/tools/run-complete-project-tests.ps1 -ProjectName Hexalith.Folders.Tests
+    - name: Run complete Server project including explicit security controls
+      shell: pwsh
+      run: ./tests/tools/run-complete-project-tests.ps1 -ProjectName Hexalith.Folders.Server.Tests
+    - name: Check package archives and dependency inventory
+      shell: bash
+      run: python3 -m scripts.tests.test_release_packages
+    - name: Run capacity smoke against shared build outputs
+      shell: pwsh
+      run: ./tests/tools/run-capacity-smoke-ci-gates.ps1
+    - name: Run measured capacity calibration
+      shell: pwsh
+      run: ./tests/tools/run-capacity-calibration-gates.ps1
diff --git a/.github/actions/nightly/action.yml b/.github/actions/nightly/action.yml
new file mode 100644
index 00000000..640c0767
--- /dev/null
+++ b/.github/actions/nightly/action.yml
@@ -0,0 +1,11 @@
+name: Folders provider product checks
+description: Verify pinned provider classification and sanitized reports, then exercise the real Forgejo TLS smart HTTP provider.
+runs:
+  using: composite
+  steps:
+    - name: Check provider classification and redaction
+      shell: pwsh
+      run: ./tests/tools/run-nightly-drift-gates.ps1 -ProviderProfile pinned-snapshots
+    - name: Run real Forgejo Alpine smart HTTP smoke
+      shell: pwsh
+      run: ./tests/tools/run-forgejo-smart-http-alpine-smoke.ps1
