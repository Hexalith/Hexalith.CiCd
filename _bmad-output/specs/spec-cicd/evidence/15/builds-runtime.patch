diff --git a/.github/actions/sample-macos/action.yml b/.github/actions/sample-macos/action.yml
new file mode 100644
index 00000000..5d5f1904
--- /dev/null
+++ b/.github/actions/sample-macos/action.yml
@@ -0,0 +1,11 @@
+name: Sample MacOSTests
+description: Execute the sample product on the macOS runner after shared preparation.
+runs:
+  using: composite
+  steps:
+    - name: Run built sample MacOSTests
+      shell: pwsh
+      working-directory: Samples/Hexalith.Sample
+      run: |
+          dotnet test --project test/Hexalith.Sample.MacOSTests/Hexalith.Sample.MacOSTests.csproj --no-build --no-restore --configuration Release --stop-on-fail off
+          exit $LASTEXITCODE
diff --git a/.github/workflows/builds-ci.yml b/.github/workflows/builds-ci.yml
index 2235e841..c9a47372 100644
--- a/.github/workflows/builds-ci.yml
+++ b/.github/workflows/builds-ci.yml
@@ -65,6 +65,24 @@ jobs:
       - name: Run module action
         uses: ./.github/actions/sample-windows
 
+  sample-macos:
+    name: Sample macOS tests
+    needs: sample
+    runs-on: macos-latest
+    timeout-minutes: 15
+    permissions:
+      contents: read
+    steps:
+      - name: Prepare module
+        uses: $/Github/prepare
+        with:
+          solution: ${{ needs.sample.outputs.solution }}
+          submodules: ${{ needs.sample.outputs.submodules }}
+          global-json: ${{ needs.sample.outputs.global-json }}
+
+      - name: Run module action
+        uses: ./.github/actions/sample-macos
+
   catalog:
     runs-on: ubuntu-latest
     name: Package catalog contracts
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index cd88b194..04427fbb 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -103,6 +103,7 @@ jobs:
           dapr: ${{ steps.unit.outputs.dapr }}
