+        native_dll = bytearray(base[prefix + 'Hexalith.McpCli.dll'])
+        struct.pack_into('<II', native_dll, 88 + 96 + 14 * 8, 0, 0)
+        bit32 = bytearray(base[prefix + 'Hexalith.McpCli.dll'])
