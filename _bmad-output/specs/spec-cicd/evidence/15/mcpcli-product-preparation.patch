diff --git a/.github/actions/after-unit-tests/action.yml b/.github/actions/after-unit-tests/action.yml
new file mode 100644
index 00000000..278a8334
--- /dev/null
+++ b/.github/actions/after-unit-tests/action.yml
@@ -0,0 +1,38 @@
+name: McpCli Linux product checks
+description: Reuse built outputs for package, conformance and the complete isolated native product lane.
+runs:
+  using: composite
+  steps:
+    - name: Validate package consumers, conformance and product launcher behavior
+      shell: bash
+      run: timeout --signal=TERM --kill-after=30s 3600 "${HEXALITH_CI_PYTHON:?Shared prepared Python is required}" scripts/product_ci.py linux
+    - name: Retain identical CI fixture packages for both platform jobs
+      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+      with:
+        name: mcpcli-product-packages
+        path: ${{ runner.temp }}/mcpcli-product/staged/
+        if-no-files-found: error
+    - name: Prepare isolated native fixtures using shared environment tools
+      shell: bash
+      env:
+        ASPIRE_EVIDENCE_PATH: TestResults/live-ci
+      run: bash tools/live-topology/prepare-ci.sh
+    - name: Execute every live vector and independent case
+      shell: bash
+      env:
+        ASPIRE_EVIDENCE_PATH: TestResults/live-ci
+      run: bash tools/live-topology/run-ci.sh
+    - name: Retain product diagnostics
+      if: ${{ always() }}
+      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+      with:
+        name: mcpcli-linux-product-diagnostics
+        path: |
+          ${{ runner.temp }}/mcpcli-product/diagnostics/
+          ${{ runner.temp }}/mcpcli-product/linux/installed-tool/
+          !${{ runner.temp }}/mcpcli-product/linux/installed-tool/private/**
+          ${{ runner.temp }}/mcpcli-product/linux/consumer/build.log
+          ${{ runner.temp }}/mcpcli-product/enrolled/
+          ${{ runner.temp }}/mcpcli-product/preflight/
+          TestResults/live-ci/
+        if-no-files-found: warn
diff --git a/.github/actions/macos-product/action.yml b/.github/actions/macos-product/action.yml
new file mode 100644
index 00000000..bd26cb34
--- /dev/null
+++ b/.github/actions/macos-product/action.yml
@@ -0,0 +1,26 @@
+name: McpCli macOS product checks
+description: Test the existing macOS build and the exact CI package bytes staged on Linux.
+runs:
+  using: composite
+  steps:
+    - name: Download this run's source-bound Linux package pair
+      uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8
+      with:
+        name: mcpcli-product-packages
+        path: ${{ runner.temp }}/mcpcli-product/staged/
+    - name: Validate identical package bytes, installed tool and macOS suites
+      shell: bash
+      run: python3 scripts/product_ci.py platform --expected-os Darwin
+    - name: Retain macOS product diagnostics
+      if: ${{ always() }}
+      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+      with:
+        name: mcpcli-macos-product-diagnostics
+        path: |
+          ${{ runner.temp }}/mcpcli-product/diagnostics/
+          ${{ runner.temp }}/mcpcli-product/platform/installed-tool/
+          !${{ runner.temp }}/mcpcli-product/platform/installed-tool/private/**
+          ${{ runner.temp }}/mcpcli-product/platform/suites/
+          !${{ runner.temp }}/mcpcli-product/platform/suites/home/**
+          ${{ runner.temp }}/mcpcli-product/platform/consumer/build.log
+        if-no-files-found: warn
diff --git a/.github/actions/windows-product/action.yml b/.github/actions/windows-product/action.yml
new file mode 100644
index 00000000..b16b5a76
--- /dev/null
+++ b/.github/actions/windows-product/action.yml
@@ -0,0 +1,26 @@
+name: McpCli Windows product checks
+description: Test the existing Windows build and the exact CI package bytes staged on Linux.
+runs:
+  using: composite
+  steps:
+    - name: Download this run's source-bound Linux package pair
+      uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8
+      with:
+        name: mcpcli-product-packages
+        path: ${{ runner.temp }}/mcpcli-product/staged/
+    - name: Validate identical package bytes, installed tool and Windows suites
+      shell: bash
+      run: python scripts/product_ci.py platform --expected-os Windows
+    - name: Retain Windows product diagnostics
+      if: ${{ always() }}
+      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+      with:
+        name: mcpcli-windows-product-diagnostics
+        path: |
+          ${{ runner.temp }}/mcpcli-product/diagnostics/
+          ${{ runner.temp }}/mcpcli-product/platform/installed-tool/
+          !${{ runner.temp }}/mcpcli-product/platform/installed-tool/private/**
+          ${{ runner.temp }}/mcpcli-product/platform/suites/
+          !${{ runner.temp }}/mcpcli-product/platform/suites/home/**
+          ${{ runner.temp }}/mcpcli-product/platform/consumer/build.log
+        if-no-files-found: warn
