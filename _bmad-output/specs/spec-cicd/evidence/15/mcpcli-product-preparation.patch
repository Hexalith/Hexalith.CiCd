+    def test_staging_uses_one_no_build_pair_and_real_payload_validator(self):
+        shutil.rmtree(self.staged)
+        commands = []
+        def execute(command, **kwargs):
+            commands.append(list(map(str, command)))
+            if command[:2] == ['dotnet', 'msbuild']:
