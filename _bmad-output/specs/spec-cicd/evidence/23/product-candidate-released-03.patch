diff --git a/tests/Hexalith.Tenants.UI.Tests/Browser/published-frontcomposer-evidence.mjs b/tests/Hexalith.Tenants.UI.Tests/Browser/published-frontcomposer-evidence.mjs
new file mode 100644
index 00000000..de1dd917
--- /dev/null
+++ b/tests/Hexalith.Tenants.UI.Tests/Browser/published-frontcomposer-evidence.mjs
@@ -0,0 +1,33 @@
+import { createHash } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+
+// Bind the actual restored package closure. A dormant source checkout cannot
+// establish the identity of the Shell binary exercised by a package-mode UI.
+export async function capturePublishedFrontComposer(root) {
+    const expected = new Set(['Hexalith.FrontComposer.Contracts', 'Hexalith.FrontComposer.Shell',
+        'Hexalith.FrontComposer.Testing', 'Hexalith.FrontComposer.SourceTools']);
+    const packages = new Map();
+    const restore = createHash('sha256');
+    for (const project of ['src/Hexalith.Tenants.UI', 'tests/Hexalith.Tenants.UI.Tests']) {
+        const bytes = await readFile(resolve(root, project, 'obj/project.assets.json'));
+        restore.update(project).update('\0').update(bytes).update('\0');
+        const assets = JSON.parse(bytes);
+        for (const [identity, metadata] of Object.entries(assets.libraries)) {
+            const separator = identity.lastIndexOf('/');
+            const id = identity.slice(0, separator);
+            if (!expected.has(id)) continue;
+            const value = { id, version: identity.slice(separator + 1), sha512: metadata.sha512 };
+            if (metadata.type !== 'package' || !value.version || typeof value.sha512 !== 'string' || !value.sha512
+                || packages.has(id) && JSON.stringify(packages.get(id)) !== JSON.stringify(value)) {
+                throw Object.assign(new Error(), { safeLabel: 'frontcomposer-published-package-identity-invalid' });
+            }
+            packages.set(id, value);
+        }
+    }
+    if (packages.size !== expected.size) {
+        throw Object.assign(new Error(), { safeLabel: 'frontcomposer-published-package-closure-incomplete' });
+    }
+    return { frontComposerPackages: [...packages.values()].sort((left, right) => left.id.localeCompare(right.id)),
+        frontComposerRestoreSha256: restore.digest('hex') };
+}
diff --git a/tests/Hexalith.Tenants.UI.Tests/Browser/published-frontcomposer-evidence.test.mjs b/tests/Hexalith.Tenants.UI.Tests/Browser/published-frontcomposer-evidence.test.mjs
new file mode 100644
index 00000000..2f52ab73
--- /dev/null
+++ b/tests/Hexalith.Tenants.UI.Tests/Browser/published-frontcomposer-evidence.test.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { resolve } from 'node:path';
+import test from 'node:test';
+import { capturePublishedFrontComposer } from './published-frontcomposer-evidence.mjs';
+
+for (const mutation of ['none', 'source', 'missing-testing', 'different-producer', 'missing-integrity']) {
+    test(`Published UI evidence binds all four package inputs and refuses ${mutation}`, async () => {
+        const root = await mkdtemp(resolve(tmpdir(), 'tenants-published-browser-'));
+        try {
+            const definitions = ['Contracts', 'Shell', 'Testing', 'SourceTools'];
+            for (const [index, project] of ['src/Hexalith.Tenants.UI', 'tests/Hexalith.Tenants.UI.Tests'].entries()) {
+                const libraries = Object.fromEntries(definitions.filter(name => mutation !== 'missing-testing' || name !== 'Testing')
+                    .map(name => [`Hexalith.FrontComposer.${name}/${mutation === 'different-producer' && index === 1 ? '6.0.1' : '6.0.0'}`,
+                        { type: mutation === 'source' ? 'project' : 'package', sha512: mutation === 'missing-integrity' ? undefined : `integrity-${name}` }]));
+                await mkdir(resolve(root, project, 'obj'), { recursive: true });
+                await writeFile(resolve(root, project, 'obj/project.assets.json'), JSON.stringify({ libraries }));
+            }
+            if (mutation === 'none') {
+                const result = await capturePublishedFrontComposer(root);
+                assert.equal(result.frontComposerPackages.length, 4);
+                assert.match(result.frontComposerRestoreSha256, /^[0-9a-f]{64}$/);
+                assert.ok(result.frontComposerPackages.every(item => item.version === '6.0.0'));
+            } else await assert.rejects(capturePublishedFrontComposer(root));
+        } finally { await rm(root, { recursive: true, force: true }); }
+    });
+}
