+// Share the exact final provenance gate between the live validator and its controls.
+export function assertStableCapture(before, after) {
+    for (const key of Object.keys(before)) {
+        if (after[key] !== before[key]) {
+            throw Object.assign(new Error(), { safeLabel: `stable-capture-${key}` });
+        }
+    }
+}
