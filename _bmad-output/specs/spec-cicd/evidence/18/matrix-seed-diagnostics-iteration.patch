diff --git a/tests/Hexalith.Projects.Integration.Tests/PackageReadStartupTests.cs b/tests/Hexalith.Projects.Integration.Tests/PackageReadStartupTests.cs
new file mode 100644
index 00000000..826e5be2
--- /dev/null
+++ b/tests/Hexalith.Projects.Integration.Tests/PackageReadStartupTests.cs
@@ -0,0 +1,46 @@
+namespace Hexalith.Projects.Integration.Tests;
+
+using Shouldly;
+
+using Xunit;
+
+/// <summary>Requires complete stable provider observations before the unchanged writer protocol is allowed to start.</summary>
+public sealed class PackageReadStartupTests
+{
+    /// <summary>A changed byte/version observation resets readiness and requires the next identical complete inventory.</summary>
+    [Fact]
+    public async Task ChangedInventoryRequiresANewConsecutiveStableObservation()
+    {
+        int reads = 0;
+        await PackageReadFixture.ObserveStableFreshInventoryAsync(_ => Task.FromResult(Inventory(++reads == 1 ? "1" : "2")),
+            TimeSpan.FromSeconds(2), TimeSpan.Zero, TimeSpan.FromMilliseconds(1), TestContext.Current.CancellationToken);
+        reads.ShouldBe(3);
+    }
+
+    /// <summary>Missing startup state remains bounded and can never establish a quiet store.</summary>
+    [Fact]
+    public async Task PermanentlyChangingInventoryTimesOut()
+    {
+        int reads = 0;
+        await Should.ThrowAsync<OperationCanceledException>(() => PackageReadFixture.ObserveStableFreshInventoryAsync(
+            _ => Task.FromResult(Inventory((++reads).ToString(System.Globalization.CultureInfo.InvariantCulture))),
+            TimeSpan.FromMilliseconds(100), TimeSpan.Zero, TimeSpan.FromMilliseconds(1), TestContext.Current.CancellationToken));
+        reads.ShouldBeGreaterThan(1);
+    }
+
+    /// <summary>A permanent provider/contract error is propagated rather than retried as a transient inventory race.</summary>
+    [Fact]
+    public async Task ProviderContractRefusalIsNotRetried()
+    {
+        int reads = 0;
+        await Should.ThrowAsync<InvalidOperationException>(() => PackageReadFixture.ObserveStableFreshInventoryAsync(_ =>
+        {
+            reads++;
+            throw new InvalidOperationException("provider contract refused");
+        }, TimeSpan.FromSeconds(2), TimeSpan.Zero, TimeSpan.FromMilliseconds(1), TestContext.Current.CancellationToken));
+        reads.ShouldBe(1);
+    }
+
+    private static Dictionary<string, PackageReadStateSnapshot> Inventory(string version)
+        => new() { ["projection-delivery-control"] = new("projection-delivery-control", [1], version) };
+}
