+                Dictionary<string, PackageReadStateSnapshot> current = await read(quiet.Token).ConfigureAwait(false);
+                bool same = previous is not null && SameCutoverInventory(previous, current);
+                if (!same) stable.Restart();
+                previous = current;
+                if (same && stable.Elapsed >= stableWindow) return;
+            }
+            catch (Xunit.Sdk.XunitException error) when (error.Message == "Fresh cutover delivery inventory changed or has missing state."
+                && !quiet.IsCancellationRequested)
+            {
+                previous = null;
+                stable.Reset();
+            }
+            await Task.Delay(pollDelay, quiet.Token).ConfigureAwait(false);
+        }
+    }
