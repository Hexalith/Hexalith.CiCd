diff --git a/.github/actions/after-unit-tests/action.yml b/.github/actions/after-unit-tests/action.yml
new file mode 100644
index 00000000..b18ae6b5
--- /dev/null
+++ b/.github/actions/after-unit-tests/action.yml
@@ -0,0 +1,11 @@
+name: Projects generated output and package consumers
+description: Inspect existing Release generator output and validate candidate packages and five consumers.
+runs:
+  using: composite
+  steps:
+    - name: Inspect generated FrontComposer output
+      shell: bash
+      run: python3 scripts/check-frontcomposer-output.py
+    - name: Validate Release packages and consumers
+      shell: bash
+      run: python3 scripts/check-package-dependencies.py
diff --git a/.github/actions/nightly/action.yml b/.github/actions/nightly/action.yml
new file mode 100644
index 00000000..cdba1e21
--- /dev/null
+++ b/.github/actions/nightly/action.yml
@@ -0,0 +1,8 @@
+name: Projects package-mode browser and durable-state checks
+description: Run the prepared Release fixture driver and complete browser assertions with private cleanup.
+runs:
+  using: composite
+  steps:
+    - name: Run package fixture browser phases
+      shell: bash
+      run: npm --prefix tests/e2e run test:package
