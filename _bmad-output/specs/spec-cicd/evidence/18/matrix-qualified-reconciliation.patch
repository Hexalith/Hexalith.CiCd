+    private async Task<Dictionary<string, PackageReadStateSnapshot>> ReadFreshCutoverInventoryAsync(CancellationToken cancellation)
+    {
+        const string inventory = "return cjson.encode(redis.call('KEYS','*'))";
+        async Task<string[]> KeysAsync()
+        {
+            using JsonDocument document = JsonDocument.Parse(await RedisBytesAsync(cancellation, ["EVAL", inventory, "0"]).ConfigureAwait(false));
+            // Redis cjson serializes an empty Lua array as an object; startup always has real bootstrap state.
+            Require(document.RootElement.ValueKind == JsonValueKind.Array && document.RootElement.GetArrayLength() is > 0 and <= 4096,
+                "Fresh cutover requires a bounded actual provider inventory after genuine bootstrap.");
+            string[] keys = document.RootElement.EnumerateArray().Select(item => item.GetString()!).ToArray();
+            Require(keys.All(key => !string.IsNullOrWhiteSpace(key)) && keys.Distinct(StringComparer.Ordinal).Count() == keys.Length,
+                "The actual provider inventory is malformed or ambiguous.");
+            return keys.Where(ProjectionDeliveryCutoverObserver.IsRelevantStateKey).Order(StringComparer.Ordinal).ToArray();
+        }
+        string[] keys = await KeysAsync().ConfigureAwait(false);
+        Require(keys.Length <= 256, "Fresh cutover delivery inventory exceeds its bound.");
+        var values = keys.Length == 0 ? new Dictionary<string, PackageReadStateSnapshot?>()
+            : await ReadSeedDeliveryStatesAsync(keys, cancellation).ConfigureAwait(false);
+        string[] reobserved = await KeysAsync().ConfigureAwait(false);
+        if (values.Values.Any(value => value is null) || !keys.SequenceEqual(reobserved, StringComparer.Ordinal))
+        {
+            var after = reobserved.Length == 0 ? new Dictionary<string, PackageReadStateSnapshot?>()
+                : await ReadSeedDeliveryStatesAsync(reobserved, cancellation).ConfigureAwait(false);
+            static object Fingerprint(PackageReadStateSnapshot? value) => new
+            {
+                present = value is not null, versionSha256 = value is null ? null : Digest(value.ETag),
+                bytesSha256 = value is null ? null : Convert.ToHexString(SHA256.HashData(value.Bytes)), byteCount = value?.Bytes.Length ?? 0,
+            };
+            string[] changed = keys.Union(reobserved, StringComparer.Ordinal).Where(key =>
+                !values.TryGetValue(key, out var beforeValue) || beforeValue is null
+                || !after.TryGetValue(key, out var afterValue) || afterValue is null
+                || beforeValue.ETag != afterValue.ETag || !beforeValue.Bytes.AsSpan().SequenceEqual(afterValue.Bytes)).Order(StringComparer.Ordinal).ToArray();
+            Console.Error.WriteLine("[package-native] cutover-inventory-observation " + JsonSerializer.Serialize(new
+            {
+                observedAt = DateTimeOffset.UtcNow, firstKeyCount = keys.Length, finalKeyCount = reobserved.Length,
+                changedKeyCount = changed.Length, truncated = changed.Length > 16,
+                changed = changed.Take(16).Select(key => new { keySha256 = Digest(key),
+                    before = Fingerprint(values.GetValueOrDefault(key)), after = Fingerprint(after.GetValueOrDefault(key)) }).ToArray(),
+            }, Json));
+            await File.AppendAllTextAsync(Path.Combine(Evidence, "fresh-cutover-inventory-observations.jsonl"), JsonSerializer.Serialize(new
+            {
+                firstKeyCount = keys.Length, finalKeyCount = reobserved.Length,
+                missingKeySha256 = values.Where(pair => pair.Value is null).Select(pair => Digest(pair.Key)).ToArray(),
+                removedKeySha256 = keys.Except(reobserved, StringComparer.Ordinal).Select(Digest).ToArray(),
+                addedKeySha256 = reobserved.Except(keys, StringComparer.Ordinal).Select(Digest).ToArray(),
+            }, Json) + Environment.NewLine, cancellation).ConfigureAwait(false);
+        }
+        if (values.Values.Any(value => value is null) || !keys.SequenceEqual(reobserved, StringComparer.Ordinal))
+            throw new FreshCutoverInventoryChangedException();
+        return values.ToDictionary(pair => pair.Key, pair => pair.Value!, StringComparer.Ordinal);
+    }
