+        Require(HostedBootstrapReceiptMatches(value, rootDigest, PrimaryActor), "Hosted bootstrap receipt binding failed.");
+        string message = value.GetProperty("MessageId").GetString()!;
+        for (int attempt = 0; attempt < 240; attempt++)
