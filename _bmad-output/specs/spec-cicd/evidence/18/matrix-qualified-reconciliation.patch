+    /// <summary>Only the initial observation may settle; native backup and activation are never retried.</summary>
+    internal static async Task<Dictionary<string, PackageReadStateSnapshot>> AwaitFreshCutoverQuiescenceAsync(
+        Func<CancellationToken, Task<Dictionary<string, PackageReadStateSnapshot>>> read,
+        Func<Dictionary<string, PackageReadStateSnapshot>, bool> isQuiescent, CancellationToken cancellation)
+    {
+        Dictionary<string, PackageReadStateSnapshot>? previous = null;
+        Stopwatch stable = new();
+        while (true)
+        {
+            cancellation.ThrowIfCancellationRequested();
+            try
+            {
+                Dictionary<string, PackageReadStateSnapshot> current = await read(cancellation).ConfigureAwait(false);
+                if (!isQuiescent(current))
+                {
+                    previous = null;
+                    stable.Reset();
+                }
+                else
+                {
+                    if (previous is null || !SameCutoverInventory(previous, current)) stable.Restart();
+                    previous = current;
+                    if (stable.Elapsed >= TimeSpan.FromSeconds(2)) return current;
+                }
+            }
+            catch (FreshCutoverInventoryChangedException) when (!cancellation.IsCancellationRequested)
+            {
+                previous = null;
+                stable.Reset();
+            }
+            await Task.Delay(100, cancellation).ConfigureAwait(false);
+        }
+    }
