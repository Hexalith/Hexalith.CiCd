+        Exception actual = await Should.ThrowAsync<InvalidOperationException>(() => PackageReadFixture.AwaitFreshCutoverQuiescenceAsync(
+            Read, _ => true, CancellationToken.None));
+        actual.ShouldBeSameAs(expected);
+        reads.ShouldBe(1);
+    }
