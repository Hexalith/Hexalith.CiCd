+def config():
+    value = copy.deepcopy(json.loads((ROOT / "Github/lib/tests/fixtures/contract.json").read_text())[0]["document"])
+    value.update(buildsTag="v6.0.6", publishedBuilds="eng/tuple.json", jobs={})
+    return value
+
