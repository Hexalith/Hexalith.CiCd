-                digests.Length.ShouldBe(batch.Length);
-                for (int index = 0; index < batch.Length; index++)
-                {
-                    files.Add((batch[index].Path, batch[index].Mode, digests[index]));
-                }
-            }
-        }
-
-        return files;
-    }
