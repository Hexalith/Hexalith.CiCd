-                        File.CreateSymbolicLink(path, Encoding.UTF8.GetString(content));
-                    }
-                    else
-                    {
-                        File.WriteAllBytes(path, content);
-                    }
-                }
-            }
-        }
-        finally
-        {
-            File.Delete(temporary);
-        }
-    }
