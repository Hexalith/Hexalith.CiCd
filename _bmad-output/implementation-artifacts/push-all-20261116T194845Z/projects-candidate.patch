+    private async Task<PackageReadStateSnapshot[]> StatesAsync(IEnumerable<string> keys)
+    {
+        string[] selected = keys.ToArray();
+        PackageReadStateSnapshot[] raw = await RawStatesAsync(selected.Where(key => key.Contains("||", StringComparison.Ordinal)).ToArray()).ConfigureAwait(false);
+        PackageReadStateSnapshot[] logical = await ObserveIndividualStatesAsync(selected.Where(key => !key.Contains("||", StringComparison.Ordinal))).ConfigureAwait(false);
+        return [.. raw, .. logical];
+    }
