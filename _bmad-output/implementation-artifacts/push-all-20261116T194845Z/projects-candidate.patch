+        {
+            if (File.Exists(receipt))
+            {
+                using JsonDocument document = JsonDocument.Parse(await File.ReadAllBytesAsync(receipt, Cancellation).ConfigureAwait(false));
+                accepted = document.RootElement.Clone();
