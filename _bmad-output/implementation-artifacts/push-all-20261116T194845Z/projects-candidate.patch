+    /// <summary>Requires exact domain bytes and ETags after read-only operations.</summary>
+    internal async Task<PackageReadStateSnapshot[]> AssertUnchangedAsync(PackageReadStateSnapshot[] before)
+    {
+        PackageReadStateSnapshot[] observed = await SnapshotAsync().ConfigureAwait(false);
+        Require(SameDomainState(before, observed), "A read changed the persisted domain key set, bytes or ETags.");
+        return observed;
+    }
