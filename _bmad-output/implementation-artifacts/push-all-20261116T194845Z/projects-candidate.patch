+namespace Hexalith.Projects.Integration.Tests;
+
+using System.IdentityModel.Tokens.Jwt;
+using System.Net;
+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+using Hexalith.Projects.PackageFixtures;
+
+using Microsoft.IdentityModel.Tokens;
+
+using Shouldly;
+
+using Xunit;
+
+/// <summary>Preflights actual private credential issuance and every native public-user surface without AppHost or containers.</summary>
+public sealed class PackageCredentialMatrixTests
+{
+    /// <summary>Runs native input preparation, real local HTTPS/OIDC issuance, signature checks, token selection and owned cleanup.</summary>
+    [Fact]
+    public async Task NativeAuthorityPreservesBootstrapAndReaderIdentitiesAndSeparateWorkloadTrust()
+    {
+        string? isolation = null;
+        async Task<string> DockerAsync(string[] arguments, CancellationToken cancellation)
+        {
+            cancellation.ThrowIfCancellationRequested();
+            switch (arguments[0])
+            {
+                case "create":
+                    string id = new('a', 64);
+                    string file = arguments[Array.IndexOf(arguments, "--cidfile") + 1];
+                    await File.WriteAllTextAsync(file, id, cancellation).ConfigureAwait(true);
+                    return id;
+                case "inspect": return JsonSerializer.Serialize(new Dictionary<string, string> { ["hexalith.projects-package-fixtures"] = isolation! });
+                case "start": case "rm": case "ps": return string.Empty;
+                default: throw new InvalidOperationException("The offline credential preflight may not start a product backend.");
+            }
+        }
+        FixtureScratch scratch = new(true, DockerAsync);
+        isolation = scratch.Isolation;
+        string directory = scratch.Directory;
+        await using (scratch.ConfigureAwait(true))
+        {
+            string root = AppContext.BaseDirectory;
+            while (!File.Exists(Path.Combine(root, "Hexalith.Projects.CI.slnx")))
+                root = Directory.GetParent(root)?.FullName ?? throw new InvalidOperationException("Credential preflight repository root is missing.");
+            FixtureInputs inputs = new(scratch, root, true, "main");
+            await using var inputCleanup = inputs.ConfigureAwait(true);
+            await inputs.PrepareAsync(TestContext.Current.CancellationToken);
+            inputs.NativeCredentials.ShouldBeTrue();
+            using RSA user = RSA.Create();
+            user.ImportFromPem(await File.ReadAllTextAsync(scratch.File("native-user.pem"), TestContext.Current.CancellationToken));
+            using JsonDocument configuration = JsonDocument.Parse(await File.ReadAllBytesAsync(scratch.File("configuration.json"), TestContext.Current.CancellationToken));
+            JsonElement settings = configuration.RootElement.GetProperty("Projects").GetProperty("PackageFixtures");
+            user.ExportSubjectPublicKeyInfo().ShouldNotBe(Convert.FromBase64String(settings.GetProperty("OwnerPublicKey").GetString()!));
+            Dictionary<string, string> browser = new()
+            {
+                ["TenantToken"] = inputs.ReaderTokens["actor-1"], ["ForeignToken"] = inputs.ReaderTokens["foreign-actor"],
+                ["TenantBootstrapToken"] = inputs.Tokens["actor-1"], ["ForeignBootstrapToken"] = inputs.Tokens["foreign-actor"],
+            };
+            JsonElement selection = JsonSerializer.SerializeToElement(browser);
+            JwtSecurityTokenHandler handler = new();
+            foreach ((string username, string tenant) in new[] { ("actor-1", inputs.Tenant), ("foreign-actor", inputs.ForeignTenant) })
+                foreach (bool administrator in new[] { false, true })
+                {
+                    string encoded = PackageReadFixture.BrowserHumanToken(selection, tenant, inputs.ForeignTenant, administrator);
+                    encoded.ShouldBe((administrator ? inputs.Tokens : inputs.ReaderTokens)[username]);
+                    _ = handler.ValidateToken(encoded, new TokenValidationParameters
+                    {
+                        ValidIssuer = inputs.Authority, ValidAudience = "supported-read-users", IssuerSigningKey = new RsaSecurityKey(user),
+                        ValidateIssuer = true, ValidateAudience = true, ValidateLifetime = true, ValidateIssuerSigningKey = true,
+                    }, out SecurityToken validated);
+                    JwtSecurityToken token = (JwtSecurityToken)validated;
+                    token.Subject.ShouldBe(inputs.Subjects[username]);
+                    token.Claims.Where(claim => claim.Type == "eventstore:tenant").Select(claim => claim.Value).ShouldBe([tenant]);
+                    token.Claims.Single(claim => claim.Type == "tenant_id").Value.ShouldBe(tenant);
+                    token.Claims.Single(claim => claim.Type == "azp").Value.ShouldBe("operator-web");
+                    token.Claims.Single(claim => claim.Type == "eventstore:surface").Value.ShouldBe("ui");
+                    token.Claims.Single(claim => claim.Type == "projects:role").Value.ShouldBe("TenantProjectAdministrator");
+                    token.Claims.Any(claim => claim.Type == "global_admin" && claim.Value == "true").ShouldBe(administrator);
+                    foreach (string permission in new[] { "command:submit", "query:read", "projects:read", "projects:list", "tenants:refresh-access" })
+                        token.Claims.ShouldContain(claim => claim.Type == "eventstore:permission" && claim.Value == permission);
+                    token.Claims.ShouldNotContain(claim => claim.Value == "system");
+                }
+            using HttpClient http = inputs.CreateHttpClient();
+            using HttpResponseMessage metadata = await http.GetAsync(inputs.Authority + "/.well-known/openid-configuration", TestContext.Current.CancellationToken);
+            metadata.StatusCode.ShouldBe(HttpStatusCode.OK);
+            using JsonDocument discovery = JsonDocument.Parse(await metadata.Content.ReadAsByteArrayAsync(TestContext.Current.CancellationToken));
+            discovery.RootElement.GetProperty("issuer").GetString().ShouldBe(inputs.Authority);
+            using HttpResponseMessage jwks = await http.GetAsync(discovery.RootElement.GetProperty("jwks_uri").GetString(), TestContext.Current.CancellationToken);
+            jwks.StatusCode.ShouldBe(HttpStatusCode.OK);
+            using FormUrlEncodedContent invalid = new(new Dictionary<string, string>
+            {
+                ["grant_type"] = "password", ["client_id"] = "supported-read-reader", ["username"] = "actor-1", ["password"] = "invalid",
+            });
+            using HttpResponseMessage refused = await http.PostAsync(inputs.Authority + "/protocol/openid-connect/token", invalid, TestContext.Current.CancellationToken);
+            refused.StatusCode.ShouldBe(HttpStatusCode.Unauthorized);
+        }
+        Directory.Exists(directory).ShouldBeFalse();
+    }
+
+    /// <summary>Agent, ordinary operator, inspected operator and quarantine administrator keep the original principal and distinct grants.</summary>
+    [Theory]
+    [InlineData(true, false, false, "agent", "ProjectUser")]
+    [InlineData(false, false, false, "ui", "TenantOperator")]
+    [InlineData(false, true, false, "ui", "TenantOperator")]
+    [InlineData(false, true, true, "ui", "TenantProjectAdministrator")]
+    [InlineData(false, false, true, "ui", "TenantProjectAdministrator")]
+    public void NativeUserSurfacesPreservePrincipalAndInspectionPermission(bool chatbot, bool inspect, bool projectAdministrator,
+        string surface, string role)
+    {
+        List<Claim> claims = PackageReadFixture.HumanClaims("primary", "foreign", chatbot, inspect, projectAdministrator: projectAdministrator);
+        claims.Single(claim => claim.Type == "sub").Value.ShouldBe("actor-1");
+        claims.Single(claim => claim.Type == "eventstore:surface").Value.ShouldBe(surface);
+        claims.Single(claim => claim.Type == "azp").Value.ShouldBe(chatbot ? "chatbot" : "operator-web");
+        claims.Single(claim => claim.Type == "projects:role").Value.ShouldBe(role);
+        claims.Any(claim => claim.Type == "eventstore:permission" && claim.Value == "projects:inspect_descriptive_metadata").ShouldBe(inspect);
+        claims.ShouldNotContain(claim => claim.Type == "global_admin" || claim.Type == "is_global_admin");
+        claims.Where(claim => claim.Type == "eventstore:tenant").Select(claim => claim.Value).ShouldBe(["primary"]);
+    }
+
+    /// <summary>Foreign denial reaches coarse transport admission as the original primary actor with no foreign membership claim.</summary>
+    [Fact]
+    public void ForeignCoarseGrantDoesNotChangeActorOrPublicTenantIdentity()
+    {
+        List<Claim> claims = PackageReadFixture.HumanClaims("primary", "foreign", foreignTransportGrant: true);
+        claims.Where(claim => claim.Type == "eventstore:tenant").Select(claim => claim.Value).ShouldBe(["primary", "foreign"]);
+        claims.Single(claim => claim.Type == "sub").Value.ShouldBe("actor-1");
+        claims.Single(claim => claim.Type == "tenant_id").Value.ShouldBe("primary");
+        claims.ShouldNotContain(claim => claim.Value == "system" || claim.Value == "foreign-actor");
+        List<Claim> administrator = PackageReadFixture.HumanClaims("primary", "foreign", chatbot: false, administrator: true);
+        administrator.ShouldContain(claim => claim.Type == "global_admin" && claim.Value == "true");
+        administrator.ShouldContain(claim => claim.Type == "eventstore:permission" && claim.Value == "tenants:create");
+        administrator.Where(claim => claim.Type == "eventstore:tenant").Select(claim => claim.Value).ShouldBe(["primary"]);
+    }
+}
