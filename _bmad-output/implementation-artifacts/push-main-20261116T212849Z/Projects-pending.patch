+    /// <summary>Selects the real OIDC reader for product behavior and the separate bootstrap credential for owner setup/observation.</summary>
+    internal static string BrowserHumanToken(JsonElement browser, string tenant, string foreignTenant, bool administrator = false)
+        => browser.GetProperty(administrator
+            ? tenant == foreignTenant ? "ForeignBootstrapToken" : "TenantBootstrapToken"
+            : tenant == foreignTenant ? "ForeignToken" : "TenantToken").GetString()!;
