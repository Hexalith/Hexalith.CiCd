-        DoNotCopyLocalIfInGac="$(DoNotCopyLocalIfInGac)"
-        ResolvedSDKReferences="@(ResolvedSDKReference)"
-        WarnOrErrorOnTargetArchitectureMismatch="$(ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch)"
