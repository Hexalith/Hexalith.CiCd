-        MSBuildArchitecture="$(SGenMSBuildArchitecture)"
-        SerializationAssembly="$(IntermediateOutputPath)$(_SGenDllName)"
-        Platform="$(SGenPlatformTarget)"
-        Types="$(SGenSerializationTypes)">
