+        }
+        string[] projections = ProjectScopes().Select(scope => ProjectReadModelKeys.Detail(scope.Tenant, scope.Project))
+            .Concat(new[] { ProjectReadModelKeys.Index(Tenant), ProjectReadModelKeys.Index(ForeignTenant) }).ToArray();
