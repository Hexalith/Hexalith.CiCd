-        TargetType="$(Satellite_TargetType)"
-        TemplateFile="$(IntermediateOutputPath)$(TargetName)$(TargetExt)"
-        Title="$(Satellite_Title)"
-        ToolPath="$(AlToolPath)"
-        ToolExe ="$(AlToolExe)"
-        SdkToolsPath="$(_ALExeToolPath)"
-        Trademark="$(Satellite_Trademark)"
-        Version="$(Satellite_Version)"
