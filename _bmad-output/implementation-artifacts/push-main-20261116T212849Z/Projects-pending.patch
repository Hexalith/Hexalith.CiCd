-        <Type>Resx</Type>
-      </EmbeddedResource>
-      <EmbeddedResource Include="@(NonResxWithCulture);@(NonResxWithNoCulture)">
-        <Type>Non-Resx</Type>
-      </EmbeddedResource>
-    </ItemGroup>
