-        CompanyName="$(Satellite_CompanyName)"
-        Configuration="$(Satellite_Configuration)"
-        Copyright="$(Satellite_Copyright)"
-        Culture="%(Culture)"
-        DelaySign="$(DelaySign)"
-        Description="$(Satellite_Description)"
