-    <CompileDependsOn>
-      ResolveReferences;
-      ResolveKeySource;
-      SetWin32ManifestProperties;
-      _SetPreferNativeArm64Win32ManifestProperties;
-      FindReferenceAssembliesForReferences;
-      _GenerateCompileInputs;
