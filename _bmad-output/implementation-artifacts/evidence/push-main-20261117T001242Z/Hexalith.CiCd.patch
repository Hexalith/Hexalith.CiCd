+            result = SCRATCH / 'worker-result.json'
+            if result.is_file():
+                status = json.loads(result.read_text())
+                if status['phases']:
+                    current = (status['phases'][-1]['name'], status['phases'][-1]['status'])
+                    if current != last_phase:
