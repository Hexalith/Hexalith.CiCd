++        Require(archives.Length == 1, "Restored package archive is missing or ambiguous.");
++        byte[] archiveBytes = File.ReadAllBytes(archives[0]);
++        string archiveSha512 = Convert.ToBase64String(SHA512.HashData(archiveBytes));
