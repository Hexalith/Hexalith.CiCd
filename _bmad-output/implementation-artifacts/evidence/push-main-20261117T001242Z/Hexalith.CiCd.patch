+* text=auto
+# Fixed OQ8 predecessor inputs retain their exact hashed LF bytes.
+.editorconfig text eol=lf
+.gitattributes text eol=lf
+# .editorconfig sets end_of_line = crlf for [*], so an EditorConfig-honouring editor rewrites
+# C# sources to CRLF while `text=auto` keeps the index at LF. That drift is invisible to
+# `git status` and breaks source-inspection tests that match newline-bearing markers.
+*.cs text eol=lf
+*.md text eol=lf
+# Imported OQ8 authority and owner permission retain their exact source Git-object bytes.
+docs/architecture/oq8/oq8-idempotency-design.md -text
+docs/architecture/oq8/LICENSE -text
+*.sh text eol=lf
+*.py text eol=lf
+# Dapr broker qualification inputs are bound by SHA-256 in runtime-lock.json.
+deploy/dapr/qualification/** text eol=lf
+# Public runtime identities (OCI indexes, pinned sources, chart archive) keep exact bytes.
+deploy/dapr/qualification/public-identities/** -text
+# Story 9.2 gate risk matrix inputs are bound by SHA-256 in every validator result.
+_bmad-output/implementation-artifacts/phase-4-gate-risk-matrix.json text eol=lf
+_bmad-output/implementation-artifacts/owner-role-registry.json text eol=lf
+.github/workflows/dapr-broker-qualification.yml text eol=lf
+# Gate workflows are hashed G-OQ8 and G-HIGH-RISK subjects.
+.github/workflows/oq8-governing-design.yml text eol=lf
+.github/workflows/phase-4-gate-risk-matrix.yml text eol=lf
+# Authenticated transition workflows and the closed contract bind exact LF bytes.
+.github/workflows/phase-4-*.yml text eol=lf
+tools/phase-4-transition.schema.json text eol=lf
+commitlint.config.mjs text eol=lf
+# Husky hooks execute through /bin/sh and must not acquire CRLF line endings.
+.husky/* text eol=lf
+*.nupkg binary
+global.json text eol=crlf
