+                self.w.pushes.clear()
+
+    def test_missing_scoped_app_token_writes_nothing(self):
+        self.w.token = ""
+        self.assert_refused(self.w.deliver(), "App token unavailable")
+
+    def test_pending_owner_gate_fails_closed_in_qualification_cli(self):
